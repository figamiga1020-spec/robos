--!strict
--[[
	Races — 15 playable races. This file is the contract between the character creator UI,
	CharacterService validation, RigBuilder (visuals) and stat computation.

	Proportions are multipliers relative to the base humanoid rig (≈5.6 studs tall):
	  Height (overall), Shoulders (torso width), Bulk (limb thickness), Head (head scale),
	  Legs (leg length share). RigBuilder must honour them; it also adds race anatomy listed
	  under Anatomy (ears, horns, tails, wings, tusks...).
	Appearance option ids listed here MUST all be implemented by RigBuilder.
]]

export type RaceDef = {
	Id: string,
	Name: string,
	NameEn: string,
	Tagline: string,
	Lore: string,
	StatMods: { [string]: number }, -- additive base attribute bonuses
	Proportions: { Height: number, Shoulders: number, Bulk: number, Head: number, Legs: number },
	Anatomy: { string }, -- always-present parts (e.g. "Tail", "Wings")
	SkinTones: { Color3 },
	HairStyles: { string },
	HairColors: { Color3 },
	EyeColors: { Color3 },
	Features: { string }, -- race detail options (first = default)
	FeatureColors: { Color3 },
	Faces: number,
	Markings: number,
	EyeGlow: boolean?,
	Phase1: boolean, -- selectable in the current build
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

