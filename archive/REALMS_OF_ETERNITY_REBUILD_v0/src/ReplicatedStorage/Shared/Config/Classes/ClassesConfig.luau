-- Architecture stubs (NOT playable in phase 1)
for _, id in {
	"Berserker", "Paladin", "Cryomancer", "Necromancer", "Druid", "Cleric",
	"Spellblade", "Warlock", "Monk", "Lancer", "Duelist", "Marksman",
	"Summoner", "Bard", "Engineer", "ShadowKnight",
} do
	if not ClassesConfig.Data[id] then
		ClassesConfig.Data[id] = {
			Id = id,
			DisplayName = id,
			Description = "Architecture placeholder. Not playable in vertical slice.",
			Role = "TBD",
			Playstyle = "TBD",
			PrimaryStats = { "Strength" },
			ResourceName = "Resource",
			ResourceMult = 1,
			HealthMult = 1,
			StaminaMult = 1,
			PreferredWeapons = {},
			ArmorType = "Medium",
			IsPhase1Playable = false,
			Skills = {},
		}
	end
end

function ClassesConfig.Get(id: string): ClassDef?
	return ClassesConfig.Data[id]
end

function ClassesConfig.GetPlayable(): { ClassDef }
	local list = {}
	for _, id in ClassesConfig.Phase1 do
		table.insert(list, ClassesConfig.Data[id])
	end
	return list
end

return ClassesConfig
